# ============================================================================
# HiddenJobs Hunter — Configuration Environment Example (.env.example)
# ============================================================================

# --- Backend (.NET 8 ASP.NET Core) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Chaîne de connexion SQLite (optionnelle, par défaut: Data Source=hiddenjobs.db)
ConnectionStrings__DefaultConnection=Data Source=hiddenjobs.db

# --- Fournisseurs IA Optionnels (configurables aussi via l'interface UI ⚙️) ---
# Mode par défaut : Heuristic (100% hors-ligne, aucune clé requise)
# Valeurs supportées : Heuristic | Gemini | OpenAI | Ollama

# Google Gemini API (optionnel)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (optionnel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama Local LLM (optionnel)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3
